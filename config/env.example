BOT_TOKEN=replace_me
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL (used by db service and DATABASE_URL; keep in sync)
POSTGRES_DB=ugc
POSTGRES_USER=ugc
POSTGRES_PASSWORD=ugc
DATABASE_URL=postgresql+psycopg://ugc:ugc@db:5432/ugc
ADMIN_USERNAME=admin
# Required for production: set strong ADMIN_PASSWORD and ADMIN_SECRET (admin app will not start if empty)
ADMIN_PASSWORD=change_me
ADMIN_SECRET=change_me_secret
ADMIN_SITE_NAME=UGC Admin
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=order_activated
KAFKA_GROUP_ID=ugc-bot
KAFKA_DLQ_TOPIC=order_activated_dlq
KAFKA_SEND_RETRIES=3
KAFKA_SEND_RETRY_DELAY_SECONDS=1.0
FEEDBACK_DELAY_MINUTES=4320
FEEDBACK_POLL_INTERVAL_SECONDS=300
FEEDBACK_ENABLED=true
TELEGRAM_PROVIDER_TOKEN=replace_me
# For Alertmanager notifications (separate from BOT_TOKEN)
TELEGRAM_BOT_TOKEN=replace_me

# Referral system
REFERRAL_SUPPORT_CHAT_ID=
REFERRAL_BOT_USERNAME=

# Order limits
ALLOWED_BLOGGER_COUNTS=1,3,5,10
MAX_ORDER_PRICE=10000
TELEGRAM_CHAT_ID=replace_me
TELEGRAM_CRITICAL_CHAT_ID=replace_me

REDIS_URL=redis://redis:6379/0
USE_REDIS_STORAGE=true

# Instagram Webhook Configuration
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_verify_token_here
INSTAGRAM_APP_SECRET=your_app_secret_here
ADMIN_INSTAGRAM_USERNAME=admin_ugc_bot

# Instagram Graph API Configuration
INSTAGRAM_ACCESS_TOKEN=your_access_token_here
INSTAGRAM_API_BASE_URL=https://graph.instagram.com

# Rapid API (Instagram stats worker, separate table instagram_stats)
RAPIDAPI_KEY=
RAPIDAPI_INSTAGRAM_HOST=instagram-v2
INSTAGRAM_RAPID_STATS_ENABLED=false
INSTAGRAM_RAPID_STATS_INTERVAL_SECONDS=86400
INSTAGRAM_RAPID_STATS_BATCH_SIZE=50
INSTAGRAM_RAPID_STATS_DELAY_SECONDS=1.0

# Public domain for this deployment (nginx SSL paths, Prometheus/Grafana URLs).
# Set to your server's domain; must match the Let's Encrypt certificate name.
DOMAIN=bot.usemycontent.ru

# Telegram Webhook (required for scalable bot deployment). Must use the same domain as DOMAIN.
WEBHOOK_BASE_URL=https://bot.usemycontent.ru
# Required for production: set secure random token for X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=

# Grafana (set GRAFANA_ADMIN_PASSWORD for production)
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=

# Database Backup Configuration
BACKUP_KEEP_DAYS=7
BACKUP_INTERVAL_HOURS=12

# Replication to Beget cloud DB (see docs/REPLICATION.md)
# Publisher is local db; subscription is created on Beget. Connection string for
# CREATE SUBSCRIPTION on Beget uses your server's public host/IP and POSTGRES_* credentials.
# REPLICATION_PUBLISHER_HOST=your-server.example.com

# S3 Backup (optional; uses path-style endpoint, e.g. Beget)
S3_BACKUP_ENABLED=false
S3_ENDPOINT_URL=https://s3.ru1.storage.beget.cloud
S3_BUCKET=97596cccd207-ugc-s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E2E tests against deployed dev contour (make e2e-dev)
# E2E_BASE_URL=https://dev.usemycontent.ru
# E2E_ADMIN_USERNAME=   # Optional; default in tests: test_admin
# E2E_ADMIN_PASSWORD=   # Optional; default in tests: test_pass

# Telegram E2E Tests (Telethon user client). Docker: first run make e2e-telegram-docker-auth (enter code), then make e2e-telegram-docker
# TELEGRAM_E2E_BOT_TOKEN=      # Test bot token from @BotFather
# TELEGRAM_E2E_BOT_USERNAME=   # Bot username without @ (e.g. ugc_test_bot)
# TELEGRAM_E2E_API_ID=         # From my.telegram.org
# TELEGRAM_E2E_API_HASH=       # From my.telegram.org
# TELEGRAM_E2E_PHONE=          # Test user phone for Telethon
# E2E_DATABASE_URL=            # Same DB as the bot for E2E. If set, pytest cleans users before e2e_telegram; or run make e2e-telegram-clean
# E2E_CLEAN_TELEGRAM=darbulat  # When running e2e_telegram against dev, delete only this user before tests; if unset and E2E_DATABASE_URL set, all users are deleted

# Tests in container on dev network (make test-all-docker-dev): set DEV_NETWORK=ugc_default (or your stack network from docker network ls). E2E_BASE_URL=http://admin:8001, E2E_DATABASE_URL=postgresql+psycopg://user:pass@db:5432/ugc
# DEV_NETWORK=ugc_default
