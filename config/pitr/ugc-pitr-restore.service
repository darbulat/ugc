[Unit]
Description=Isolated read-only UMC PITR acceptance instance

[Service]
Type=simple
User=ugc-pitr
Group=ugc-pitr
UMask=0077
RootDirectory=/opt/ugc-pitr/runtime
BindPaths=/var/lib/ugc-pitr-restore/current:/restore
BindReadOnlyPaths=/var/lib/ugc-pitr/archive:/archive
BindReadOnlyPaths=/opt/ugc-pitr/bin/age:/tools/age
BindReadOnlyPaths=/opt/ugc-pitr/current/pitr_fetch_wal.sh:/tools/fetch-wal
LoadCredential=identity:/etc/ugc-pitr/pitr.identity
ExecStart=/usr/lib/postgresql/16/bin/postgres -D /restore/pgdata -c listen_addresses= -c port=16544 -c unix_socket_directories=/restore/socket -c hba_file=/restore/hba.conf -c shared_buffers=64MB -c work_mem=4MB -c archive_mode=off -c synchronous_standby_names=
TimeoutStopSec=30
RuntimeMaxSec=15min
MemoryAccounting=yes
MemoryMax=768M
MemorySwapMax=0
CPUQuota=50%
CPUWeight=10
IOWeight=10
TasksMax=64
OOMScoreAdjust=1000
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/restore
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
