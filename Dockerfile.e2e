# E2E test image: dev deps + Playwright.
# Order: heavy deps (requirements + Playwright) first so code/test-only changes use cache.
FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update && \
    apt-get install -y --no-install-recommends postgresql-client gzip && \
    rm -rf /var/lib/apt/lists/*

# Heavy deps first: base + dev/e2e deps + Playwright — invalidates when deps change.
COPY requirements.txt requirements-dev-e2e.txt /app/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install -r requirements.txt && \
    pip install -r requirements-dev-e2e.txt && \
    pip install playwright && \
    python -m playwright install --with-deps chromium

# App in editable mode only (no deps): invalidates when app code changes; runs in ~1s.
COPY pyproject.toml conftest.py alembic.ini /app/
COPY src /app/src
COPY config /app/config
COPY scripts /app/scripts
RUN pip install --no-cache-dir -e . --no-deps

# Tests last: changes here do not invalidate the dependency layers.
COPY tests /app/tests
