# Locked dependencies are shared by the financial and browser test images.
FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Node is also used by the payout JavaScript unit tests.
RUN apt-get update && \
    apt-get install -y --no-install-recommends postgresql-client gzip nodejs && \
    rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir uv==0.13.7
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --all-extras --no-install-project

ARG INSTALL_BROWSER=true
# Playwright's Node driver needs libatomic on Linux ARM64.
RUN if [ "$INSTALL_BROWSER" = true ]; then \
        apt-get update && \
        apt-get install -y --no-install-recommends libatomic1 && \
        python -m playwright install --with-deps chromium && \
        rm -rf /var/lib/apt/lists/*; \
    fi

COPY conftest.py alembic.ini ./
COPY src ./src
COPY config ./config
COPY scripts ./scripts
COPY tests ./tests
RUN uv sync --locked --all-extras
